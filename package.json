{
  "name": "poseify",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Free, open-source browser-based 3D pose reference tool for artists.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "vite-node tools/setup-assets.ts",
    "setup": "vite-node tools/setup-assets.ts",
    "models:fetch": "vite-node tools/fetch-models.ts",
    "models:verify": "vite-node tools/verify-models.ts",
    "clips:build": "vite-node tools/build-clips.ts"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "^5.6.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.4",
    "vue": "^3.5.12",
    "vue-tsc": "^2.1.10"
  }
}
