{
  "name": "poseify",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Free, open-source browser-based 3D pose reference tool for artists.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && npm run demo:build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
        "test:watch": "vitest",
        "clips:build": "vite-node tools/build-clips.ts",
        "poses:generate": "vite-node tools/build-pose-library.ts",
        "scenes:generate": "vite-node tools/build-scene-library.ts",
        "demo:build": "vite-node tools/build-demo.ts"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "^5.6.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.4",
    "vue": "^3.5.12",
    "vue-tsc": "^2.1.10"
  }
}




